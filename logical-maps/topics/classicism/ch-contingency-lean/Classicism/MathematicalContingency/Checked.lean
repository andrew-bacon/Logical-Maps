namespace Classicism.MathematicalContingency
-- Closed identities expose the definitions to the formula/type checker without
-- pretending that polymorphic definition declarations themselves are formulas.
theorem assumptions_unfold (ν κ σ τ ρ : Type) [Ty ν] [Ty κ] [Ty σ] [Ty τ] [Rel ρ] :
    AssumptionsAt ν κ σ τ ρ ↔
      (DraftBoxInfinity ν ∧ BoxRC ρ ∧ IC ρ ∧ TwoAlgebraCoverage κ σ τ) := Iff.rfl
theorem targets_unfold (η : Type) [Ty η] :
    CHContingency η ↔ (PossibleCH η ∧ PossibleNotCH η) := Iff.rfl
#classicism_check assumptions_unfold targets_unfold
#classicism_types assumptions_unfold targets_unfold
end Classicism.MathematicalContingency
